{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (Aspire, emulators)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OddsCollector.AppHost/bin/Debug/net11.0/OddsCollector.AppHost.dll",
      "cwd": "${workspaceFolder}/src/OddsCollector.AppHost",
      "launchSettingsProfile": "http",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Function app only (func host)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:azureFunctions.pickProcess}",
      "preLaunchTask": "func: host start"
    },
    {
      "name": "Attach to process (e.g. Functions worker started by AppHost)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
