<Project Sdk="Aspire.AppHost.Sdk/13.6.2">
  <!--
    Runs the function app against Microsoft's emulators (Cosmos DB, Service Bus, Azurite) for local development
    and for OddsCollector.Functions.IntegrationTests. Needs Docker and Azure Functions Core Tools (func).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>oddscollector-apphost</UserSecretsId>
    <!--
      Orchestration (DCP) and the dashboard come from NuGet packages instead of the Aspire CLI bundle, so building and
      testing need no Aspire CLI. ASPIRE010 only recommends the bundle.
    -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB"/>
    <PackageReference Include="Aspire.Hosting.Azure.Functions"/>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OddsCollector.Functions\OddsCollector.Functions.csproj"/>
  </ItemGroup>
</Project>
